# ── Sprout — environment variables ──────────────────────────────────────────────
# Copy to .env.local and fill in the blanks:
#     cp .env.example .env.local
# The Docker Compose app service reads these (via compose), Next also reads
# .env.local for local `bun run start`. Never commit real values.

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev Postgres, started by `bun run db:up` (docker compose).
DATABASE_URL=postgres://sprout:sprout@localhost:5432/sprout

# Production only: the direct, non-pooled connection string used by `db:migrate`
# so schema changes bypass the connection pooler. Leave unset locally.
# DIRECT_URL=

# ── Better Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Used to sign auth session cookies. Keep secret; rotating it signs everyone out.
BETTER_AUTH_SECRET=

# Base URL of the app. Must match where you run it in dev.
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth ────────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── PlantNet (required) ─────────────────────────────────────────────────────────
# The shared API key (https://my.plantnet.org) used server-side for species
# identification.
PLANTNET_API_KEY=

# ── Web Push & cron ─────────────────────────────────────────────────────────────
# Generate the key pair with: bunx web-push generate-vapid-keys --json
# The public key reaches the browser, so it keeps the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only signing key for the push payloads. Keep secret.
VAPID_PRIVATE_KEY=
# Contact URL push services can use to reach you, as a mailto: address.
VAPID_SUBJECT=mailto:you@example.com
# Vercel sends cron requests this as `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -base64 32
CRON_SECRET=
