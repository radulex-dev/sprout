{
  "name": "@radulex-dev/sprout",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "next dev",
    "start:prod": "next start",
    "prepare": "husky",
    "build": "bun run build:rules && next build",
    "build:rules": "tsc -p tsconfig.eslint-rules.json",
    "prelint": "bun run build:rules",
    "lint": "bun run lint:js && bun run lint:css",
    "lint:js": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"*.ts\" \"*.mjs\"",
    "lint:css": "stylelint \"src/**/*.css\" && eslint \"src/**/*.css\"",
    "lint:fix": "bun run lint:js -- --fix && stylelint \"src/**/*.css\" --fix && eslint \"src/**/*.css\" --fix",
    "lint:staged": "lint-staged",
    "lint:commits": "commitlint --from HEAD~1 --to HEAD",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:size": "size-limit",
    "postpack": "find src eslint-rules -name \"*.js\" -type f -delete",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:studio": "drizzle-kit studio",
    "docker:build:prod": "docker build --target prod -t sprout ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@internationalized/date": "^3.12.4",
    "@react-oauth/google": "^0.13.5",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.6.29",
    "classnames": "^2.5.1",
    "compressorjs": "^1.3.0",
    "drizzle-orm": "^0.45.2",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "pwa-install-handler": "^2.6.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "ua-parser-js": "^2.0.10",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
    "@eslint/css": "^2.0.0",
    "@onefinity/eslint-config": "^4.1.0",
    "@onefinity/stylelint-config": "^3.3.0",
    "@size-limit/file": "^14.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/classnames": "^2.3.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/utils": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "size-limit": "^14.0.0",
    "tailwind-csstree": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "eslint": "10.11.0"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "unrs-resolver"
  ]
}
