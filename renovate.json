{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "platformAutomerge": false,
    "packageRules": [
        {
            "description": "Stay on Postgres 16 until the v18 container issue is resolved",
            "matchDatasources": ["docker"],
            "matchPackageNames": ["postgres"],
            "allowedVersions": "<17"
        },
        {
            "description": "TypeScript minor/major bumps need a dashboard checkbox until typescript-eslint supports them (https://github.com/typescript-eslint/typescript-eslint/issues/10940)",
            "matchDatasources": ["npm"],
            "matchPackageNames": ["typescript"],
            "matchUpdateTypes": ["minor", "major"],
            "dependencyDashboardApproval": true
        },
        {
            "description": "Auto-merge minor and patch updates once CI is green",
            "matchUpdateTypes": ["minor", "patch"],
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "description": "Major updates open a PR and wait for review",
            "matchUpdateTypes": ["major"],
            "automerge": false
        }
    ]
}
