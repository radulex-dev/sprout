          "name": "care_reference_water_range",
          "value": "(\"care_reference\".\"water_interval\" is null and \"care_reference\".\"water_unit\" is null) or (\"care_reference\".\"water_interval\" is not null and \"care_reference\".\"water_unit\" is not null and \"care_reference\".\"water_unit\" in ('D', 'M', 'Y') and \"care_reference\".\"water_interval\" * case \"care_reference\".\"water_unit\" when 'D' then 1 when 'M' then 30 else 365 end between 2 and 28)"
